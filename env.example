# Required for AI features
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional: change the Gemini model without editing Python code.
GEMINI_MODEL=gemini-3.8-flash

# Explanation mode:
# gemini = recommended/default; uses the same Gemini API as other features.
# local  = downloads and runs LaMini-Flan-T5-783M locally.
EXPLANATION_MODE=gemini

# Used only when EXPLANATION_MODE=local
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

# Optional application limits/settings
MAX_INPUT_CHARS=20000
CORS_ORIGINS=*
